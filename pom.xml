<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.8</version>
        <relativePath/>
    </parent>
    <groupId>com.warmer</groupId>
    <artifactId>kgbuilder</artifactId>
    <version>0.0.1</version>
    <name>kgBuilder</name>
    <packaging>pom</packaging>
    <description>Demo project for kgBuilder</description>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>17</java.version>
        <neo4j.version>5.12.0</neo4j.version>
        <mybatis.version>3.0.3</mybatis.version>
        <pagehelper.version>2.0.0</pagehelper.version>
        <fastjson.version>1.2.83</fastjson.version>
        <commons-lang3.version>3.13.0</commons-lang3.version>
        <qiniu-sdk.version>7.14.0</qiniu-sdk.version>
        <poi.version>5.2.4</poi.version>
        <javacsv.version>2.0</javacsv.version>
        <hanlp.version>portable-1.8.4</hanlp.version>
        <lombok.version>1.18.30</lombok.version>
        <hutool.version>5.8.22</hutool.version>
        <commons-fileupload.version>1.5</commons-fileupload.version>
    </properties>
    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>

</dependencies>
    <modules>
        <module>kgBuilder-base</module>
        <module>kgBuilder-meta</module>
        <module>kgBuilder-pro</module>
    </modules>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
